{
  "name": "bot-chain-crash-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A reproducible adversarial smart-contract simulation and Passport proof demo for BOT Chain.",
  "license": "MIT",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "contracts:compile": "node scripts/contracts/compile.mjs",
    "contracts:deploy:patched": "node scripts/contracts/deploy-patched-vault.mjs",
    "contracts:publisher": "node scripts/contracts/setup-publisher.mjs",
    "contracts:demo": "node scripts/contracts/run-demo.mjs",
    "contracts:verify": "node scripts/contracts/verify-deployments.mjs"
  },
  "dependencies": {
    "ethers": "6.17.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "solc": "0.8.24",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
